# Copy to .env. Never commit your real key.
OPENAI_API_KEY=

# Text lesson model: cost-sensitive by default.
OPENAI_MODEL=gpt-5.6-luna

# Visual generation + semantic QA.
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_COMPRESSION=82

# Strict semantic threshold. 98 means the AI QA must score >=98/100 AND all hard checks true.
# This is an AI evaluation score, not a mathematical guarantee of 98% accuracy.
VISUAL_MATCH_THRESHOLD=98

# Maximum image generations per visual request. Keep 1-2 to control cost.
VISUAL_MAX_ATTEMPTS=2

SECRET_KEY=change-this-to-a-long-random-string
FLASK_DEBUG=1
PORT=5000
# Absolute safety cap per lesson, across repeated user retries.
VISUAL_TOTAL_MAX_ATTEMPTS=4

# Admin dashboard
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_MONTHLY_BUDGET_USD=20
USD_VND_RATE=26000

# Pricing overrides (USD per 1M tokens). Defaults are embedded in services/cost_service.py.
# Example: PRICE_GPT_5_6_LUNA_TEXT_INPUT_PER_M=0.20
